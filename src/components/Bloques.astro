---
import { Image } from 'astro:assets';
import { imagenDe } from '../lib/medios';
import type { Bloque, Medio } from '../lib/tipos';

interface Props {
  bloques: Bloque[];
  medios: Medio[];
  respaldo: string;
}
const { bloques, medios, respaldo } = Astro.props;
const partes = bloques.map((b) =>
  b.tipo === 'html'
    ? { tipo: 'html' as const, html: b.html }
    : {
        tipo: 'figura' as const,
        imagen: imagenDe(b.archivo),
        pie: b.pie,
        alt: b.pie || medios.find((m) => m.archivo === b.archivo)?.alt || '',
      },
);
---
<div class="texto-articulo">
  {
    partes.map((p) =>
      p.tipo === 'html' ? (
        <Fragment set:html={p.html} />
      ) : p.imagen ? (
        <figure class="figura">
          <Image src={p.imagen} alt={p.alt} width={480} data-respaldo={respaldo} />
          {p.pie && <figcaption>{p.pie}</figcaption>}
        </figure>
      ) : null,
    )
  }
</div>

<style>
  .texto-articulo :global(p),
  .texto-articulo :global(li) {
    font-size: 1.125rem;
    line-height: 1.5;
  }
  .texto-articulo > :global(p:first-child) {
    font-size: 1.3125rem;
  }
  .texto-articulo :global(h2) {
    margin: 1.2em 0 0.3em;
    font-size: 1.5rem;
    color: var(--naranja-titulo);
  }
  .texto-articulo :global(h3) {
    margin: 1em 0 0.3em;
    font-size: 1.25rem;
    font-weight: bold;
  }
  .texto-articulo :global(a) {
    text-underline-offset: 2px;
  }
  .figura {
    margin: 1rem 0;
    padding: 8px;
    background: #fff;
    border: 2px solid var(--recuadro-borde);
    border-radius: 12px;
    max-width: 500px;
  }
  .figura figcaption {
    font-size: 0.9rem;
    color: var(--texto-suave);
  }
</style>
